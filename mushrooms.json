  "scoring_rules": {
    "rain": {
      "weight": 0.35,
      "description": "Total precipitation in last N days vs trigger threshold",
      "formula": "min(actual_mm / trigger_mm, 1.5) * weight"
    },
    "temperature": {
      "weight": 0.25,
      "description": "Current temp within ideal range scores full points",
      "formula": "gaussian_score(current_temp, ideal_min, ideal_max) * weight"
    },
    "wind": {
      "weight": 0.2,
      "description": "Low wind = high score. Max daily gust threshold: 40 km/h",
      "formula": "max(0, 1 - gust_kmh/40) * weight"
    },
    "altitude": {
      "weight": 0.1,
      "description": "Station altitude within species ideal range",
      "formula": "gaussian_score(altitude, ideal_min, ideal_max) * weight"
    },
    "humidity": {
      "weight": 0.1,
      "description": "Relative humidity > 70% preferred",
      "formula": "min(humidity_pct / 70, 1.0) * weight"
    }
  },
